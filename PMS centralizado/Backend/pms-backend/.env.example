# ─────────────────────────────────────────────────────────────────────────────
# PMS Backend — variables de entorno
# Copiar a `.env` y completar. `.env` está ignorado por git; este archivo no.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: en producción activa cookies Secure, SameSite=strict y bloqueo de
# hoteles suspendidos. Sin esto la app corre como desarrollo.
NODE_ENV=development
PORT=4000
# Saltos de proxy confiables delante de la API (Render/Cloudflare/nginx = 1).
# Con esto el rate limit usa la IP real del cliente. Usar 0 si la API se expone
# directo a internet, para que nadie pueda falsear su IP con X-Forwarded-For.
TRUST_PROXY=1

# ─── Base de datos (PostgreSQL / Supabase) ───────────────────────────────────
# DATABASE_URL debe usar el pooler (puerto 6543 en Supabase) e incluir sslmode.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
# Opcional: conexión directa para migraciones (puerto 5432).
DIRECT_URL=

# Alternativa a DATABASE_URL: si se omite, se arma desde estas piezas.
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# ─── Sesión / JWT ────────────────────────────────────────────────────────────
# JWT_SECRET es obligatorio: sin él no se firman tokens.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# ─── CORS y enlaces de invitación ────────────────────────────────────────────
# Sólo estos orígenes pueden llamar la API. FRONTEND_URL también se usa para
# armar el enlace de invitación por correo (/accept-invite?token=...).
# SameSite=strict exige que front y API compartan un mismo dominio registrable
# (ej. app.midominio.com + api.midominio.com), no dominios distintos.
FRONTEND_URL=http://localhost:3000
STATIC_WEBSITE_URL=

# ─── Correo transaccional (Resend) ───────────────────────────────────────────
# Sin RESEND_API_KEY las invitaciones y avisos de contraseña no se envían.
RESEND_API_KEY=
RESEND_FROM=Kazehana Cloud <noreply@kazehanacloud.com>

# ─── Cuenta del gestor SaaS ──────────────────────────────────────────────────
# Se crea/actualiza sola al iniciar sesión con estas credenciales.
GESTOR_EMAIL=
GESTOR_PASSWORD=
GESTOR_NAME=Gestor SaaS
GESTOR_SYSTEM_HOTEL_NAME=Gestor SaaS

# ─── Facturación electrónica (proveedor Microfactura CR) ─────────────────────
MICROFACTURA_URL=
MICROFACTURA_API_KEY=

# SMTP de respaldo para reenviar comprobantes por correo. Normalmente se
# configura desde Facturación Electrónica → SMTP (por hotel).
SMTP_HOST=

# ─── Formulario público de contacto ──────────────────────────────────────────
FORMINFO_API_KEY=
TURNSTILE_SECRET_KEY=
FORMINFO_TO=
FORMINFO_FROM=
FORMINFO_SMTP_HOST=
FORMINFO_SMTP_PORT=587
FORMINFO_SMTP_USER=
FORMINFO_SMTP_PASS=
