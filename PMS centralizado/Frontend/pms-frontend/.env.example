# PMS Frontend — variables de entorno (Vite)
# Copiar a `.env`. Sólo las variables con prefijo VITE_ llegan al navegador.

# URL base de la API, sin barra final.
#
# Producción en AWS (S3 + CloudFront): dejar "/api" (relativo).
# El SPA y la API viven en el MISMO dominio de CloudFront (/ -> S3,
# /api/* -> EC2), así que no hay CORS y la cookie httpOnly con
# SameSite=strict sí viaja. No poner el dominio de la API aquí.
VITE_API_URL=/api

# Desarrollo local contra el backend en el puerto 4000:
# VITE_API_URL=http://localhost:4000/api

# Activa respuestas simuladas en lugar de llamar al backend. Nunca en producción.
VITE_MOCK=

# Permite que un 404/501 del backend caiga al mock. Por defecto está apagado
# para que un endpoint faltante se vea como error y no como dato inventado.
VITE_ALLOW_MOCK_FALLBACK=
